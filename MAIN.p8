pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
#include titlescreen.p8
#include loadingscreen.p8
#include player.p8


-- the initialization function
function _init()
  titlescreen_init()
  -- loadingscreen_init()
  isOnTitleScreen = true
end


function _update()
  -- loadingscreen_update()

  if (isOnTitleScreen == true) then
    titlescreen_update()
    return
  end
  

  if isLoadingNewLevel == false then
    player_update()
  else
    loadingscreen_update()
  end
end

-- the draw function (rendering)
function _draw()
  cls() -- clear the screen

  
  if (isOnTitleScreen == true) then
    titlescreen_draw()
    return
  end
  
  if isLoadingNewLevel == false then
    player_draw()
  else
    loadingscreen_draw()
  end
end


